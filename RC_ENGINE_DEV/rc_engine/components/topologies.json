{
  "library": "topologies",
  "version": "1.0",
  "slot_types": {
    "thesis": "central thesis / main idea — requires integrating the full movement of the passage",
    "structural_function": "why a particular move (analogy, concession, example, tonal shift) was introduced; the answer is a structural role, not local meaning",
    "contextual_inference": "interpret a dense phrase or compressed claim from its local argumentative context",
    "application": "a NEW real-world scenario (not a paraphrase); identify which mechanism from the passage best explains it",
    "implicit_assumption": "an unstated premise necessary for a major argumentative move",
    "stance": "the author's intellectual posture, avoiding simplistic binaries",
    "decoy_escape": "directly tests whether the reader escaped the passage's planted early misreading",
    "evidence_function": "what work an example or piece of evidence does (illustrate, prove, complicate, license)",
    "counterfactual_structure": "how the argument would change if a specified paragraph were removed or replaced",
    "strengthen": "which new fact would most strengthen a specified claim from the passage",
    "weaken": "which new fact would most weaken a specified claim from the passage",
    "author_vs_reported": "distinguish the author's own view from views the author reports or steelmans",
    "closure_reading": "what the ending does — why the passage stops where it does and what is implied next",
    "phrase_in_context": "the meaning of a specific phrase as used in the passage, not in general usage",
    "detail_check": "a precise factual/claim-level detail from the passage"
  },
  "items": [
    {"id": "QT01", "name": "Classic Gauntlet", "curve": "rising",
     "slots": [
       {"type": "thesis", "target": "global", "difficulty": 0.6},
       {"type": "detail_check", "target": "local", "difficulty": 0.4},
       {"type": "structural_function", "target": "local", "difficulty": 0.6},
       {"type": "contextual_inference", "target": "local", "difficulty": 0.7},
       {"type": "implicit_assumption", "target": "span", "difficulty": 0.8},
       {"type": "application", "target": "global", "difficulty": 0.9}]},
    {"id": "QT02", "name": "Inverted", "curve": "rising",
     "slots": [
