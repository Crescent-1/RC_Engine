       {"type": "detail_check", "target": "local", "difficulty": 0.5},
       {"type": "structural_function", "target": "local", "difficulty": 0.6},
       {"type": "stance", "target": "global", "difficulty": 0.7},
       {"type": "implicit_assumption", "target": "span", "difficulty": 0.8},
       {"type": "thesis", "target": "global", "difficulty": 0.9}]},
    {"id": "QT03", "name": "Structural Emphasis", "curve": "flat_high",
