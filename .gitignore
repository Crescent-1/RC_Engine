# secrets — never commit the API key
.env
outreach/.env
outreach/runtime/

# SQLite databases (production, dry-run) — data lives outside VCS
*.db

# python bytecode
__pycache__/
*.pyc

# Chroma vector store (binary, regenerable from RAG.py)
essay_rc_db/

# Client deliverables. NEVER commit these (2026-09-21, operator decision).
# They were public on GitHub from 2026-07-13 until the history rewrite of
# 2026-09-21 removed them from every commit. Exclusivity is part of what the
# client pays for, so the shipped sets live on disk and in ~/rc_data/backups/,
# not in version control. exported_rc_sets_dryrun/ below is mock output and
# was always excluded.
exported_rc_sets/

# dry-run export folder (mock output only)
exported_rc_sets_dryrun/

# GUI runtime artifacts (job log history, vet temp files)
gui/jobs_history.jsonl
gui/_vet_tmp/

# Office lock files
~$*

# local-machine Claude settings
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Isolated website publishing repository and generated static output
.site-publish/
website/dist/
website/.sites-runtime/
